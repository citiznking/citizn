#!/bin/sh
# Reject AI-attribution trailers/footers. Commits in this repo are authored
# as "Citizn <hello@citizn.example>" only — no names, no AI byline.

msg_file="$1"

pattern='(Co-Authored-By:.*([Cc]laude|[Aa]nthropic|[Cc]hatgpt|[Oo]pen ?AI|[Cc]opilot|[Gg]emini)|Generated with \[?Claude|🤖 Generated with|Generated by [Cc]laude)'

if grep -Eiq "$pattern" "$msg_file"; then
  echo "commit-msg hook: AI-attribution trailer/footer detected — remove it." >&2
  exit 1
fi
